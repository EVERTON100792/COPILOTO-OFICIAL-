# ============ PROSPEX AUTOPILOT — Variáveis de ambiente ============
# Copie para .env.local e preencha. Todas opcionais (modo DEMO default).

# Demo (default true): usa dados fictícios e simula envios.
VITE_DEMO_MODE=true

# IA — OpenCode, OpenRouter, OpenAI-compat ou Anthropic
# VITE_AI_PROVIDER=opencode
# VITE_AI_API_KEY=
# VITE_AI_MODEL=deepseek-v4-pro
# VITE_AI_BASE_URL=https://opencode.ai/zen/v1

# Busca (SerpAPI ou Google CSE)
# VITE_SEARCH_PROVIDER=serpapi
# VITE_SEARCH_API_KEY=

# Google Maps / Places (enriquecimento + Real Discovery — fonte de busca real)
# Sem esta chave, o modo REAL de busca fica bloqueado (nunca usa mock como real).
# Também pode ser salva pela tela /integrations (localStorage, mascarada).
# VITE_MAPS_API_KEY=

# E-mail (Resend | sendgrid | smtp)
# VITE_EMAIL_PROVIDER=resend
# VITE_EMAIL_API_KEY=

# WhatsApp (meta-cloud | evolution)
# VITE_WHATSAPP_PROVIDER=meta-cloud
# VITE_WHATSAPP_API_KEY=
# VITE_WHATSAPP_PHONE_ID=

# Supabase (capacidade persistência e banco)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=